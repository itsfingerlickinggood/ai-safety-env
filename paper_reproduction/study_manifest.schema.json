{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "study_id", "model", "collection", "provenance", "cells", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["id", "provider", "generation_parameters"],
      "properties": {"id": {"const": "claude-sonnet-4-6"}}
    },
    "collection": {
      "type": "object",
      "required": ["items_per_cell", "epochs_per_item", "budget_usd", "input_provenance"],
      "properties": {
        "items_per_cell": {"const": 20},
        "epochs_per_item": {"const": 4},
        "budget_usd": {"const": 50}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["prompt_manifest", "scorer_configuration", "collection_timestamp", "collection_seed"]
    },
    "cells": {"type": "array", "minItems": 9, "maxItems": 9},
    "files": {"type": "array", "minItems": 9}
  }
}
