{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_question", "hypotheses", "data_mapping", "parameters", "controls", "ablations", "falsification_criteria", "leakage_controls", "analysis_plan", "analysis_manifest"],
  "properties": {
    "schema_version": {"const": 1},
    "research_question": {"type": "string", "minLength": 40},
    "hypotheses": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "data_mapping": {"type": "array"},
    "parameters": {"type": "object"},
    "controls": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "ablations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "falsification_criteria": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "leakage_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "analysis_plan": {"type": "array", "minItems": 1},
    "analysis_manifest": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": {"enum": ["low_binary", "mid_binary", "high_binary", "low_ordinal", "mid_ordinal", "high_ordinal", "low_continuous", "mid_continuous", "high_continuous", "fixed_budget_baseline", "item_order_sensitivity", "stopping_conservatism_sensitivity"]}
    }
  }
}
