FROM python:3.12-slim

ARG HUD_ENV_MODULE=env.py

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HUD_AGENT_UID=65532 \
    HUD_AGENT_GID=65532 \
    HUD_SANDBOX_EXEC=/usr/local/bin/hud-sandbox-exec \
    HUD_ENV_MODULE=${HUD_ENV_MODULE}

# HUD's build runtime blocks user namespaces, so use a privilege wall plus a
# seccomp launcher rather than bubblewrap. util-linux supplies setpriv, which
# HUD uses to drop every agent shell to HUD_AGENT_UID.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates gcc libc6-dev libseccomp-dev libseccomp2 util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY sandbox/hud_sandbox.c /tmp/hud_sandbox.c
RUN gcc -O2 -Wall -Wextra -Werror /tmp/hud_sandbox.c -lseccomp -o /usr/local/bin/hud-sandbox-exec \
    && mkdir -p /opt/hud-sandbox/bin \
    && ln -s /usr/local/bin/hud-sandbox-exec /opt/hud-sandbox/bin/bash \
    && rm /tmp/hud_sandbox.c \
    && apt-get purge -y gcc libc6-dev libseccomp-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.runtime.txt /app/requirements.runtime.txt
RUN pip install --no-cache-dir --require-hashes -r /app/requirements.runtime.txt

COPY env.py env_monitoring.py tasks.py tasks_paper.py tasks_monitoring.py /app/
COPY workspace_seed /app/workspace_seed
COPY paper_reproduction /app/paper_reproduction
COPY verifier /app/verifier
COPY sandbox/test_production_sandbox.py /app/sandbox/test_production_sandbox.py
RUN chmod -R go-rwx /app/verifier /app/paper_reproduction/release /app/paper_reproduction/vendor \
    && chmod 0755 /usr/local/bin/hud-sandbox-exec /opt/hud-sandbox/bin

# Fail before upload if the evidence package is incomplete, then verify the
# namespace-free production boundary.
RUN python /app/verifier/preflight_core_package.py \
    && python /app/sandbox/test_production_sandbox.py

EXPOSE 8765
CMD ["sh", "-c", "hud serve \"${HUD_ENV_MODULE}\" --host 0.0.0.0 -p 8765"]
